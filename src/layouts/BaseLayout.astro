---
const { title = 'Ars Memoriae' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Ars Memoriae documenta colecciones privadas." />
    <title>{title}</title>
    <script is:inline>
      const savedTheme = localStorage.getItem('ars-memoria-theme');
      document.documentElement.dataset.theme = savedTheme === 'light' ? 'light' : 'dark';
    </script>
  </head>
  <body>
    <button class="theme-toggle" type="button" aria-pressed="false" aria-label="Cambiar a tema claro">
      <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" />
      </svg>
      <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M20.5 15.2A8.5 8.5 0 0 1 8.8 3.5 8.5 8.5 0 1 0 20.5 15.2Z" />
      </svg>
    </button>
    <slot />
    <script is:inline>
      const themeToggle = document.querySelector('.theme-toggle');
      const updateThemeToggle = () => {
        const isLight = document.documentElement.dataset.theme === 'light';
        themeToggle?.setAttribute('aria-pressed', String(isLight));
        themeToggle?.setAttribute('aria-label', isLight ? 'Cambiar a tema oscuro' : 'Cambiar a tema claro');
      };
      updateThemeToggle();
      themeToggle?.addEventListener('click', () => {
        const nextTheme = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = nextTheme;
        localStorage.setItem('ars-memoria-theme', nextTheme);
        updateThemeToggle();
      });
    </script>
  </body>
</html>
