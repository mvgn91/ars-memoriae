---
import { ArrowUp, Sun, Moon } from 'lucide-astro';
import WhatsApp from '../components/WhatsApp.astro';
const { title = 'Ars Memoriae' } = Astro.props;
---
<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Ars Memoriae documenta colecciones privadas. Cada proyecto se define con su propietario: qué se documenta, en qué formato y con qué alcance." />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('ars-memoria-theme') === 'light' ? 'light' : 'dark'; } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#inicio">Ir al contenido</a>
    <button class="theme-toggle" type="button" aria-pressed="false" aria-label="Cambiar a tema claro"><Sun class="theme-icon--sun" aria-hidden="true" /><Moon class="theme-icon--moon" aria-hidden="true" /></button>
    <div class="ambient-field" aria-hidden="true"><canvas class="silk-canvas" data-silk-canvas></canvas></div>
    <div class="floating-actions" role="group" aria-label="Acciones rápidas">
      <button class="floating-action floating-action--top" type="button" aria-label="Subir al inicio" title="Subir al inicio"><ArrowUp aria-hidden="true" /></button>
      <a class="floating-action" href="https://wa.me/523322621939" target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp" title="WhatsApp"><WhatsApp /></a>
    </div>
    <slot />
    <script>
      const themeToggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const updateThemeToggle = () => {
        const isLight = document.documentElement.dataset.theme === 'light';
        themeToggle?.setAttribute('aria-pressed', String(isLight));
        themeToggle?.setAttribute('aria-label', isLight ? 'Cambiar a tema oscuro' : 'Cambiar a tema claro');
      };
      updateThemeToggle();
      themeToggle?.addEventListener('click', () => {
        const nextTheme = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = nextTheme;
        try { localStorage.setItem('ars-memoria-theme', nextTheme); } catch {}
        updateThemeToggle();
      });
      document.querySelector('.floating-action--top')?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
      });
    </script>
  </body>
</html>
